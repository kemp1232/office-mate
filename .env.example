# ---------------------------------------------------------------------------
# First Mate Attendance — environment variables. Copy to .env.local for local dev.
# All variables are SERVER-ONLY (none use the NEXT_PUBLIC_ prefix).
# ---------------------------------------------------------------------------

# Postgres connection used by the app at runtime, as the least-privilege `attendance_app` role.
# Local (supabase start): postgresql://attendance_app:attendance_app_local_dev@127.0.0.1:57322/postgres
# Production (Supabase transaction pooler):
#   postgresql://attendance_app.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql://attendance_app:attendance_app_local_dev@127.0.0.1:57322/postgres

# Privileged connection used ONLY by tests and `npm run admin:create`. Never set on Vercel.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Canonical public origin of the app (used for auth, email links and the QR code).
BETTER_AUTH_URL=http://localhost:3000

# Organisation timezone that defines the attendance day. Not Admin-editable.
ATTENDANCE_TIMEZONE=Asia/Manila

# Google Workspace SSO for Team Members (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave empty locally to use only the Admin password sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
