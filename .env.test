# Test environment — LOCAL Supabase only (committed on purpose: no real secrets here).
# Integration and E2E tests load this with override, so they never touch the database that
# .env.local points at (which may be the hosted project).
DATABASE_URL=postgresql://attendance_app:attendance_app_local_dev@127.0.0.1:57322/postgres
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres
BETTER_AUTH_SECRET=local-test-only-secret-not-for-production-000000
BETTER_AUTH_URL=http://localhost:3000
ATTENDANCE_TIMEZONE=Asia/Manila
GOOGLE_CLIENT_ID=e2e-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=e2e-secret
# Tests must never write to a real Google Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
